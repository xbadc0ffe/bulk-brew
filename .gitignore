# Dependencies and build output
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.vite/

# Raw third-party data (downloaded by scripts, never committed)
data/raw/
data/packs/
data/corpus/
data/edhrec/
data/spellbook/
apps/*/public/data/
docs/rules/*
!docs/rules/README.md

# Local tooling and OS files
.env
.env.*
.DS_Store
Thumbs.db
desktop.ini
*.log
.idea/
.vscode/*
!.vscode/extensions.json

# Browser smoke test output
.smoke/

# The owner's personal bulk lists, used for local testing only
test-bulk/

# Claude Code local settings
.claude/settings.local.json

# iOS build output and user state (apps/web/ios/.gitignore covers the rest)
apps/web/ios/App/Pods/
apps/web/ios/DerivedData/
xcuserdata/

# Review panel data, held-out pools and answer keys included (docs/evaluation.md)
data/review/

# Agent worktrees
.claude/worktrees/
