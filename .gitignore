# Dependencies and build output
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.vite/

# Raw third-party data (downloaded by scripts, never committed)
data/raw/
data/packs/
data/corpus/
apps/*/public/data/
docs/rules/*
!docs/rules/README.md

# Local tooling and OS files
.env
.env.*
.DS_Store
Thumbs.db
desktop.ini
*.log
.idea/
.vscode/*
!.vscode/extensions.json

# Browser smoke test output
.smoke/

# The owner's personal bulk lists, used for local testing only
test-bulk/

# Claude Code local settings
.claude/settings.local.json

# iOS (generated by Capacitor; committed later once the mobile app exists)
apps/mobile/ios/App/Pods/
apps/mobile/ios/App/App.xcworkspace/xcuserdata/
apps/mobile/ios/DerivedData/
